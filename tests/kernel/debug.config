# Kernel config fragment for `make kernel-test-debug` (vng --build -f): what
# virtme-ng's minimal config needs on top for the VM suites, plus the checkers
# the distribution kernels lack.

# Memory errors, lock order, sleeping in atomic context, undefined behaviour.
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
CONFIG_KFENCE=y
CONFIG_SLUB_DEBUG=y
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_DEBUG_OBJECTS_TIMERS=y
CONFIG_DEBUG_OBJECTS_WORK=y
CONFIG_DEBUG_LIST=y
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_DEBUG_KMEMLEAK=y
# Scanned once, at the end of the run (test-faults.sh), not in the background.
CONFIG_DEBUG_KMEMLEAK_AUTO_SCAN=n
CONFIG_DEBUG_KMEMLEAK_MEM_POOL_SIZE=64000

# Allocation failures on demand (failslab with fail-nth, test-faults.sh).
CONFIG_DEBUG_FS=y
CONFIG_FAULT_INJECTION=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_FAILSLAB=y
# reject-start/-end: test-faults.sh spares dev_set_name(), whose failure
# hid_add_device() does not check (kernel 6.18) -- an upstream oops, not ours.
CONFIG_FAULT_INJECTION_STACKTRACE_FILTER=y

# What the suites drive: HID, uhid fake pads, the real hid-playstation, evdev.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYDEV=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_HID=y
CONFIG_HIDRAW=y
CONFIG_UHID=m
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_POWER_SUPPLY=y

# The USB side: dummy_hcd with the gadget stack (functionfs, kernel-usb) and
# usbhid on the host side; ACM only to take the UDC in a test.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_HID=m
CONFIG_USB_GADGET=m
CONFIG_USB_DUMMY_HCD=m
CONFIG_USB_LIBCOMPOSITE=m
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_CONFIGFS_FS=y
