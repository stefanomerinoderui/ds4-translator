obj-m := hid-ds4-translator.o
hid-ds4-translator-y := ds4t-driver.o ds4t-chardev.o ds4t-control.o \
				       ds4t-vcore.o ds4t-vhid.o ds4t-translate.o

# The kernel-usb backend's gadget, only where the kernel has gadget support
# (it uses libcomposite's endpoint and string helpers).
ifneq ($(CONFIG_USB_LIBCOMPOSITE),)
obj-m += ds4t-gadget.o
endif

# ds4t.h is shared with the daemon: it lives in include/uapi/ in the repository
# and is copied next to the sources in the DKMS tree (make stage-dkms).
ccflags-y := -I$(src) -I$(src)/../include/uapi
